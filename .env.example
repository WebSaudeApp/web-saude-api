NODE_ENV=development
PORT=3000

# Origens permitidas pelo CORS (separadas por vírgula). Nunca use * em produção.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Pooler em modo transação (IPv4). Caracteres especiais da senha devem ser URL-encoded (# → %23).
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler em modo sessão (usado pelo Prisma Migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Alternativa local com Docker (descomente se não for usar o Supabase):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/websaude"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/websaude"

# Rate limiting global (ttl em milissegundos)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# true em desenvolvimento; false em produção
SWAGGER_ENABLED=true


# Elasticsearch (busca textual e geográfica)
# Em desenvolvimento local: http://localhost:9200 (com segurança desabilitada no docker-compose)
# Em produção (Elastic Cloud / servidor próprio): URL https com autenticação por credencial ou API key
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
