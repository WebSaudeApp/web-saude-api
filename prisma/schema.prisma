generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PATIENT
  FUNCTIONAL
  ADMIN
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  phone          String
  passwordHash   String
  role           UserRole
  emailVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sessions             Session[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  healthUnits          HealthUnit[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

enum HealthUnitType {
  HOSPITAL
  CLINIC
}

enum HealthUnitStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model HealthUnit {
  id               String           @id @default(uuid())
  ownerId          String
  name             String
  type             HealthUnitType
  description      String?
  email            String?
  phone            String?
  whatsapp         String?
  website          String?
  status           HealthUnitStatus @default(INACTIVE)
  approvalStatus   ApprovalStatus   @default(DRAFT)
  rejectionReason  String?
  street           String
  number           String
  complement       String?
  city             String
  state            String
  cep              String
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  averageRating    Decimal          @default(0) @db.Decimal(3, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  owner        User            @relation(fields: [ownerId], references: [id])
  specialties  UnitSpecialty[]
  openingHours OpeningHour[]
  images       UnitImage[]

  @@index([ownerId])
  @@index([city, state])
  @@index([type, approvalStatus, status])
  @@map("health_units")
}

model Specialty {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units UnitSpecialty[]

  @@map("specialties")
}

model UnitSpecialty {
  unitId      String
  specialtyId String

  unit      HealthUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  specialty Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([unitId, specialtyId])
  @@map("unit_specialties")
}

model OpeningHour {
  id        String    @id @default(uuid())
  unitId    String
  dayOfWeek DayOfWeek
  openTime  String
  closeTime String
  active    Boolean   @default(true)

  unit HealthUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, dayOfWeek])
  @@index([unitId])
  @@map("opening_hours")
}

model UnitImage {
  id        String   @id @default(uuid())
  unitId    String
  url       String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  unit HealthUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("unit_images")
}
