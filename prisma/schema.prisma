generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoContato {
  TELEFONE
  WHATSAPP
  EMAIL
  SITE
}

enum TipoMidia {
  FOTO
  VIDEO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum HealthUnitStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model TipoUsuario {
  id   String @id @default(uuid())
  nome String @unique

  usuarios Usuario[]

  @@map("tipos_usuario")
}

model TipoEstabelecimento {
  id   String @id @default(uuid())
  nome String @unique

  estabelecimentos Estabelecimento[]

  @@map("tipos_estabelecimento")
}

model Usuario {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  phone         String
  cpf           String?
  genero        String?
  passwordHash  String
  tipoId        String
  enderecoId    String?   @unique
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tipo     TipoUsuario @relation(fields: [tipoId], references: [id])
  endereco Endereco?   @relation(fields: [enderecoId], references: [id])

  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  estabelecimentos   Estabelecimento[]
  reviews            Review[]
  favorites          Favorite[]
  auditLogs          AuditLog[]
  contatos           Contato[]

  @@map("usuarios")
}

model Session {
  id               String    @id @default(uuid())
  usuarioId        String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessions")
}

model EmailVerification {
  id        String    @id @default(uuid())
  usuarioId String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_resets")
}

model Estabelecimento {
  id              String           @id @default(uuid())
  ownerId         String
  nome            String
  tipoId          String
  description     String?
  status          HealthUnitStatus @default(INACTIVE)
  approvalStatus  ApprovalStatus   @default(DRAFT)
  rejectionReason String?
  enderecoId      String           @unique
  averageRating   Decimal          @default(0) @db.Decimal(3, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  owner          Usuario                        @relation(fields: [ownerId], references: [id])
  tipo           TipoEstabelecimento            @relation(fields: [tipoId], references: [id])
  endereco       Endereco                       @relation(fields: [enderecoId], references: [id])
  contatos       Contato[]
  especialidades EstabelecimentoEspecialidade[]
  horarios       HorarioFuncionamento[]
  midias         Midia[]
  reviews        Review[]
  favorites      Favorite[]

  @@index([ownerId])
  @@index([tipoId, approvalStatus, status])
  @@map("estabelecimentos")
}

model Especialidade {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estabelecimentos EstabelecimentoEspecialidade[]

  @@map("especialidades")
}

model EstabelecimentoEspecialidade {
  estabelecimentoId String
  especialidadeId   String

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  especialidade   Especialidade   @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)

  @@id([estabelecimentoId, especialidadeId])
  @@map("estabelecimento_especialidades")
}

model HorarioFuncionamento {
  id                String    @id @default(uuid())
  estabelecimentoId String
  diaSemana         DiaSemana
  horaAbertura      DateTime  @db.Time
  horaFechamento    DateTime  @db.Time
  atende24h         Boolean   @default(false)
  active            Boolean   @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, diaSemana])
  @@index([estabelecimentoId])
  @@map("horarios_funcionamento")
}

model Midia {
  id                String    @id @default(uuid())
  estabelecimentoId String
  tipo              TipoMidia @default(FOTO)
  url               String
  legenda           String?
  isMain            Boolean   @default(false)
  bytes             Bytes?
  createdAt         DateTime  @default(now())

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@index([estabelecimentoId])
  @@map("midias")
}

model Endereco {
  id          String   @id @default(uuid())
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String?
  cidade      String
  estado      String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estabelecimento Estabelecimento?
  usuario         Usuario?

  @@index([cidade, estado])
  @@map("enderecos")
}

model Contato {
  id                String      @id @default(uuid())
  estabelecimentoId String?
  usuarioId         String?
  tipo              TipoContato
  valor             String
  createdAt         DateTime    @default(now())

  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  usuario         Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, tipo, valor])
  @@unique([usuarioId, tipo, valor])
  @@map("contatos")
}

model Review {
  id                String   @id @default(uuid())
  autorId           String
  estabelecimentoId String
  nota              Int
  comentario        String?
  criadoEm          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  autor           Usuario         @relation(fields: [autorId], references: [id], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([autorId, estabelecimentoId])
  @@index([estabelecimentoId])
  @@map("reviews")
}

model Favorite {
  usuarioId         String
  estabelecimentoId String
  createdAt         DateTime @default(now())

  usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, estabelecimentoId])
  @@index([estabelecimentoId])
  @@map("favorites")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor Usuario @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
