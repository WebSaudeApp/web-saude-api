generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoContato {
  TELEFONE
  WHATSAPP
  EMAIL
  SITE
}

enum TipoMidia {
  FOTO
  VIDEO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum PapelUsuario {
  PACIENTE
  GESTOR
  ADMINISTRADOR
}

enum StatusUsuario {
  ATIVO
  PENDENTE
  SUSPENSO
  INATIVO
}

model TipoEstabelecimento {
  id   String @id @default(uuid())
  nome String @unique

  estabelecimentos Estabelecimento[]

  @@map("tipos_estabelecimento")
}

model Estabelecimento {
  id         String  @id @default(uuid())
  nome       String
  descricao  String?
  tipoId     String
  enderecoId String  @unique
  gestorId   String?

  gestor         Usuario?                       @relation("GestorEstabelecimentos", fields: [gestorId], references: [id], onDelete: SetNull)
  tipo           TipoEstabelecimento            @relation(fields: [tipoId], references: [id])
  endereco       Endereco                       @relation(fields: [enderecoId], references: [id])
  contatos       Contato[]
  especialidades EstabelecimentoEspecialidade[]
  horarios       HorarioFuncionamento[]
  midias         Midia[]

  @@index([tipoId])
  @@index([gestorId])
  @@map("estabelecimentos")
}

model Usuario {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senhaHash    String
  telefone     String?
  cpf          String?       @unique
  papel        PapelUsuario  @default(PACIENTE)
  status       StatusUsuario @default(ATIVO)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  desativadoEm DateTime?

  sessoes          Sessao[]
  estabelecimentos Estabelecimento[] @relation("GestorEstabelecimentos")

  @@index([email])
  @@map("usuarios")
}

model Sessao {
  id         String    @id @default(uuid())
  usuarioId  String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

model Especialidade {
  id   String @id @default(uuid())
  nome String @unique

  estabelecimentos EstabelecimentoEspecialidade[]

  @@map("especialidades")
}

model EstabelecimentoEspecialidade {
  estabelecimentoId String
  especialidadeId   String

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  especialidade   Especialidade   @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)

  @@id([estabelecimentoId, especialidadeId])
  @@map("estabelecimento_especialidades")
}

model HorarioFuncionamento {
  id                String    @id @default(uuid())
  estabelecimentoId String
  diaSemana         DiaSemana
  horaAbertura      DateTime  @db.Time
  horaFechamento    DateTime  @db.Time
  atende24h         Boolean   @default(false)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, diaSemana])
  @@map("horarios_funcionamento")
}

model Midia {
  id                String    @id @default(uuid())
  estabelecimentoId String
  tipo              TipoMidia @default(FOTO)
  url               String
  legenda           String?
  bytes             Bytes?

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@index([estabelecimentoId])
  @@map("midias")
}

model Endereco {
  id          String  @id @default(uuid())
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String?
  cidade      String
  estado      String
  latitude    Float
  longitude   Float

  estabelecimento Estabelecimento?

  @@index([cidade, estado])
  @@index([latitude, longitude])
  @@map("enderecos")
}

model Contato {
  id                String      @id @default(uuid())
  estabelecimentoId String
  tipo              TipoContato
  valor             String

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, tipo, valor])
  @@map("contatos")
}
